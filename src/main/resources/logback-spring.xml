<?xml version="1.0" encoding="UTF-8"?>
<!--
    生产日志配置。

    默认只往控制台打，进程一重启日志就没了；这里补上按天滚动的文件日志：
      - canteen-review.log        全量，按天 + 50MB 切分，压缩保留 15 天
      - canteen-review-error.log  只留 WARN 及以上，排查时不用翻全量

    日志目录由 app.log-dir 决定（默认 ./logs），
    systemd 里已把 WorkingDirectory 固定，所以实际落在 /opt/canteen-review/logs。
-->
<configuration>

    <springProperty scope="context" name="LOG_DIR" source="app.log-dir" defaultValue="./logs"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>
    <property name="LOG_CHARSET" value="UTF-8"/>

    <!-- 控制台：前台启动 / docker logs 时看这个 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 全量文件日志 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/canteen-review.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/canteen-review.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 告警文件：只收 WARN / ERROR -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/canteen-review-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/canteen-review-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>${LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 业务日志保持 INFO：审核动作、AI 调用、限流命中都要能查 -->
    <logger name="org.example.canteenreview" level="INFO"/>

    <!-- 框架日志压到 WARN：MyBatis 的 SQL 明细在生产只会刷屏 -->
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="io.lettuce" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>

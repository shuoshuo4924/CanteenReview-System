# 部署到 /etc/canteen-review/env 后由 systemd 注入，不要提交真实值到 git。
# 权限：chown root:root /etc/canteen-review/env && chmod 600 /etc/canteen-review/env

# 激活生产 profile（application-prod.yaml）。
# 不加这一行，下面 override 的数据库 TLS、模板缓存、图片目录全都不生效。
SPRING_PROFILES_ACTIVE=prod

# ---------- 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=canteen_review
# 不要用 root。建专用账号并强制 SSL：
#   CREATE USER 'canteen'@'localhost' IDENTIFIED BY '强密码' REQUIRE SSL;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON canteen_review.* TO 'canteen'@'localhost';
#   FLUSH PRIVILEGES;
# （如果依赖 schema.sql 自动建表，再补 CREATE, ALTER, DROP；生产通常手工执行 DDL，不给 DDL 权限）
MYSQL_USER=canteen
MYSQL_PASSWORD=change-me

# ---------- Cookie ----------
# 走 HTTPS 后必须设为 true：否则 session cookie 会明文传输，且浏览器不回传会导致"登录成功但立刻掉线"
COOKIE_SECURE=true

# ---------- AI ----------
# 留空则 AI 功能降级不可用，不影响其他功能
DEEPSEEK_API_KEY=change-me

# ---------- 目录 ----------
# 图片真实保存目录；/var/lib/canteen-review 由 systemd 的 StateDirectory 创建并归 canteen 用户所有
IMAGE_DIR=/var/lib/canteen-review/images/
LOG_DIR=/opt/canteen-review/logs

# ---------- Redis ----------
# 只有 app.rate-limit.store 改成 redis 才需要。这几个变量由 application-prod.yaml
# 映射到 spring.data.redis.*，所以变量名不要改成 SPRING_DATA_REDIS_* 那一套，二选一即可。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

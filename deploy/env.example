# 部署到 /etc/canteen-review/env 后由 systemd 注入，不要提交真实值到 git。
# 权限：chown root:root /etc/canteen-review/env && chmod 600 /etc/canteen-review/env

# 数据库密码（application.yaml 里是 ${MYSQL_PASSWORD:}）
MYSQL_PASSWORD=change-me

# DeepSeek 的 Key，留空则 AI 功能降级不可用（不会影响其他功能）
DEEPSEEK_API_KEY=change-me

# 走 HTTPS 后必须设为 true，否则浏览器不回传 cookie，表现为"登录成功但立刻掉线"
COOKIE_SECURE=true

# 只有开启 Redis 限流时才需要（同时要把 app.rate-limit.store 改成 redis）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

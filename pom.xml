<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>CanteenReview</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>CanteenReview</name>

    <properties>
        <java.version>17</java.version>

        <!-- ===== 覆盖 Spring Boot BOM 里仍带 CVE 的传递依赖 =====
             属性名都是 spring-boot-dependencies 里预定义的，
             在这里赋值即可全局生效，不需要 exclude 逐条处理。
             tomcat / netty / spring-framework / spring-security 不再覆盖：
             Boot 4.1.2 自带的就是各分支最新的补丁版本。 -->
        <log4j2.version>2.26.1</log4j2.version>
        <mysql.version>26.10.0</mysql.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- easyexcel 4.0.3 带的是 POI 5.2.5，这里再抬到 5.x 最后一个补丁版本；
                 不直接跳 6.0.0，避开大版本 API 变更。 -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi</artifactId>
                <version>5.5.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>5.5.1</version>
            </dependency>

            <!-- POI 传递进来的压缩/IO 库同样需要抬版本 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 1. Web 开发 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 2. Thymeleaf 网页模板（刚刚补上的！） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 3. MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 3.1 支持 JSQLParser 解析 SQL 语句 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.18.1</version>
        </dependency>
        <!-- 4. Lombok 简化代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 阿里 EasyExcel，用于处理 Excel 导入导出 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>4.0.3</version>
        </dependency>
        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 把 Web 层测试自动配置（@AutoConfigureMockMvc）从 starter-test 里拆了出来，
             不加这个 @Autowired MockMvc 会报 No qualifying bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 5. MyBatis-Plus：Boot 4 必须用 boot4 版 starter，boot3 版依赖的
             org.springframework.boot.autoconfigure 包在 Boot 4 里已迁移，启动会报 NoClassDefFoundError -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.18.1</version>
        </dependency>

        <!-- 5.1 扩展模块：提供 IService / ServiceImpl（3.5.7 之后不再随 starter 自动引入，必须手动加） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
            <version>3.5.18.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 6. 汉字转拼音：评论过滤器用它生成拼音变体，挡住 "jiaweixin" 这类绕过 -->
        <dependency>
            <groupId>com.belerweb</groupId>
            <artifactId>pinyin4j</artifactId>
            <version>2.5.1</version>
        </dependency>

        <!-- 7. Redis：app.rate-limit.store=redis 时，限流状态多实例共享 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 8. ZXing：晒图里夹带二维码（导流、收款码）时识别并拒绝 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JDK 21+ 默认不再自动运行注解处理器（等效 -proc:none），
                 不显式声明 Lombok 时，实体类的 getter/setter 一律“找不到符号”。
                 这里写死注解处理器路径，命令行构建就不用再带 -Dmaven.compiler.proc=full。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 依赖漏洞扫描：默认不激活，不拖慢日常构建（首次运行要下载 NVD 库，几百 MB）。
             用法：mvnw -Psecurity-scan dependency-check:check
             本地已有 NVD 库、不想再等更新时加 -DautoUpdate=false。
             CVSS >= 7 的漏洞会让命令失败，适合挂在 CI 上做发布前卡口。 -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.3</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- 同时出 JSON，方便脚本统计/比对漏洞数量 -->
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <!-- 下面三个分析器都要连境外站点：RetireJS 走 GitHub raw、
                                 Node Audit 走 npm、OSS Index 走 Sonatype。
                                 这个项目是纯 Java 后端，用不上，禁掉可以少三个失败点。
                                 注意：OSS Index 的参数名是小写 i 的 ossindexAnalyzerEnabled，
                                 写成 ossIndexAnalyzerEnabled 会被 Maven 静默忽略。 -->
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>